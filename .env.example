# Application Environment
APP_NAME="JARWAYA JEWELS"
APP_TAGLINE="Exquisite Fine Jewellery & Modern Heirlooms"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_CURRENCY=PKR
APP_CURRENCY_SYMBOL="Rs."

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jewels_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Cookie Security Configuration
SESSION_DRIVER=file
SESSION_NAME=bijoux_session
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Logging
LOG_CHANNEL=single
LOG_LEVEL=warning

