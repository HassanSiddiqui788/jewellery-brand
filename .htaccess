# ==============================================================================
# Lorem Ipsum Store - Apache Configuration & SEO Redirects
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 0. Block direct HTTP access to internal architecture directories & dotfiles
    # --------------------------------------------------------------------------
    RewriteRule ^(app|bootstrap|config|core|database|includes|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|README\.md|database/migrate\.php)$ - [F,L,NC]

    # --------------------------------------------------------------------------
    # 1. 301 Permanent Redirects for Legacy URLs (SEO Preservation)
    # --------------------------------------------------------------------------
    
    # Homepage duplicate
    RewriteRule ^home-2/?$ index.php [R=301,L]

    # Shop & Collections
    RewriteRule ^collections/?$ shop/collections/index.php [R=301,L]
    RewriteRule ^product/([^/]+)/?$ shop/product/$1/index.php [R=301,L]
    RewriteRule ^product-category/([^/]+)/?$ shop/categories/$1/index.php [R=301,L]
    RewriteRule ^product-tag/([^/]+)/?$ shop/tags/$1/index.php [R=301,L]

    # Informational Pages
    RewriteRule ^our-story/?$ pages/about.php [R=301,L]
    RewriteRule ^our-materials/?$ pages/our-materials.php [R=301,L]
    RewriteRule ^retail-store/?$ pages/retail-store.php [R=301,L]
    RewriteRule ^customer-reviews/?$ pages/customer-reviews.php [R=301,L]
    RewriteRule ^contact-us/?$ pages/contact.php [R=301,L]
    RewriteRule ^faq/?$ pages/faq.php [R=301,L]
    RewriteRule ^delivery/?$ pages/shipping.php [R=301,L]
    RewriteRule ^return-cancellations/?$ pages/returns.php [R=301,L]
    RewriteRule ^gift-cards/?$ pages/gift-cards.php [R=301,L]

    # Blog / Journal
    RewriteRule ^journal/?$ blog/index.php [R=301,L]
    RewriteRule ^2020/04/11/([^/]+)/?$ blog/posts/$1/index.php [R=301,L]
    RewriteRule ^category/([^/]+)/?$ blog/categories/$1/index.php [R=301,L]
    RewriteRule ^tag/([^/]+)/?$ blog/tags/$1/index.php [R=301,L]

    # --------------------------------------------------------------------------
    # 2. Legacy Asset Fallbacks (Safety net for external hotlinks)
    # --------------------------------------------------------------------------
    RewriteRule ^wp-content/uploads/2020/(.*)$ assets/images/2020/$1 [L]
    RewriteRule ^wp-content/uploads/2024/(.*)$ assets/images/2024/$1 [L]
    RewriteRule ^wp-content/uploads/2020/05/logo\.svg$ assets/icons/logo.svg [L]

    # --------------------------------------------------------------------------
    # 3. Gradual Front Controller Fallback (Only for non-file/non-dir routes)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# 4. Security Headers & File Protection
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block access to dotfiles, environment files, logs, backups, SQL dumps, and Composer manifests
<FilesMatch "(^\.|composer\.(json|lock)$|\.(env|sql|log|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. Cache-Control for Static Assets
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

