# ==============================================================================
# Lorem Ipsum Store - Apache Configuration & SEO Redirects
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 1. 301 Permanent Redirects for Legacy URLs (SEO Preservation)
    # --------------------------------------------------------------------------
    
    # Homepage duplicate
    RewriteRule ^home-2/?$ index.php [R=301,L]

    # Shop & Collections
    RewriteRule ^collections/?$ shop/collections/index.php [R=301,L]
    RewriteRule ^product/([^/]+)/?$ shop/product/$1/index.php [R=301,L]
    RewriteRule ^product-category/([^/]+)/?$ shop/categories/$1/index.php [R=301,L]
    RewriteRule ^product-tag/([^/]+)/?$ shop/tags/$1/index.php [R=301,L]

    # Informational Pages
    RewriteRule ^our-story/?$ pages/about.php [R=301,L]
    RewriteRule ^our-materials/?$ pages/our-materials.php [R=301,L]
    RewriteRule ^retail-store/?$ pages/retail-store.php [R=301,L]
    RewriteRule ^customer-reviews/?$ pages/customer-reviews.php [R=301,L]
    RewriteRule ^contact-us/?$ pages/contact.php [R=301,L]
    RewriteRule ^faq/?$ pages/faq.php [R=301,L]
    RewriteRule ^delivery/?$ pages/shipping.php [R=301,L]
    RewriteRule ^return-cancellations/?$ pages/returns.php [R=301,L]
    RewriteRule ^gift-cards/?$ pages/gift-cards.php [R=301,L]

    # Blog / Journal
    RewriteRule ^journal/?$ blog/index.php [R=301,L]
    RewriteRule ^2020/04/11/([^/]+)/?$ blog/posts/$1/index.php [R=301,L]
    RewriteRule ^category/([^/]+)/?$ blog/categories/$1/index.php [R=301,L]
    RewriteRule ^tag/([^/]+)/?$ blog/tags/$1/index.php [R=301,L]

    # --------------------------------------------------------------------------
    # 2. Legacy Asset Fallbacks (Safety net for external hotlinks)
    # --------------------------------------------------------------------------
    RewriteRule ^wp-content/uploads/2020/(.*)$ assets/images/2020/$1 [L]
    RewriteRule ^wp-content/uploads/2024/(.*)$ assets/images/2024/$1 [L]
    RewriteRule ^wp-content/uploads/2020/05/logo\.svg$ assets/icons/logo.svg [L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Security Headers & Options
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to hidden files and include templates
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------------------------
# 4. Cache-Control for Static Assets
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

