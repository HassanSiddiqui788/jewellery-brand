{
    "name": "bijoux/jewellery-brand",
    "description": "Core PHP luxury jewellery e-commerce storefront, modular backend, and admin platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "core/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "migrate": "php database/migrate.php up",
        "migrate:status": "php database/migrate.php status"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

